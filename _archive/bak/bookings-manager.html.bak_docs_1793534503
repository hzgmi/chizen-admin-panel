<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>CHIZEN — لوحة الحجوزات</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{--bg:#0a0825;--s:rgba(255,255,255,0.04);--s2:rgba(255,255,255,0.08);--b:rgba(59,130,246,0.15);--p:#3b82f6;--p2:#2563eb;--ac:#a855f7;--ok:#22c55e;--wr:#f59e0b;--er:#ef4444;--wa:#25D366}
body{font-family:system-ui,-apple-system,sans-serif;background:var(--bg);color:#e5e7eb;min-height:100vh;padding-bottom:80px;line-height:1.5}
.hidden{display:none!important}
header{background:linear-gradient(135deg,#1e3a8a,#1e1b4b);padding:14px 16px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:50;box-shadow:0 4px 16px rgba(0,0,0,.5);border-bottom:1px solid var(--b)}
header .left{display:flex;align-items:center;gap:10px;min-width:0;flex:1}
.avatar{width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#a855f7);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:900;color:#fff;flex-shrink:0}
.h-name{font-size:14px;font-weight:900;color:#fff}
.h-role{font-size:11px;color:#93c5fd;margin-top:1px}
#logout-btn{background:rgba(239,68,68,.15);color:#fca5a5;border:1px solid rgba(239,68,68,.3);width:36px;height:36px;border-radius:10px;font-size:16px;cursor:pointer;flex-shrink:0}
.view{display:none}.view.active{display:block}
.home-wrap{padding:16px}
.welcome{background:linear-gradient(135deg,#1e3a8a,#a855f7);border-radius:20px;padding:24px 20px;color:#fff;margin-bottom:20px;box-shadow:0 16px 48px rgba(168,85,247,.3)}
.w-greet{font-size:20px;font-weight:900;margin-bottom:4px}
.w-sub{font-size:13px;opacity:.9}
.w-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}
.w-stat{background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.25);border-radius:14px;padding:12px 8px;text-align:center}
.w-stat .v{font-size:22px;font-weight:900;line-height:1}
.w-stat .l{font-size:10px;opacity:.9;margin-top:3px;font-weight:700}
.section-title{font-size:15px;font-weight:900;color:#93c5fd;margin:18px 0 12px}
.services-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.svc-card{background:linear-gradient(135deg,var(--s),var(--s2));border:1px solid var(--b);border-radius:18px;padding:22px 14px;text-align:center;cursor:pointer;position:relative;overflow:hidden}
.svc-card:active{transform:scale(.97)}
.svc-card .ic{font-size:36px;margin-bottom:8px}
.svc-card .lbl{font-size:14px;font-weight:800;color:#fff}
.svc-card .cnt{position:absolute;top:10px;left:10px;background:var(--er);color:#fff;border-radius:20px;min-width:24px;height:24px;font-size:11px;font-weight:900;display:flex;align-items:center;justify-content:center;padding:0 6px}
.tabs{display:flex;gap:6px;padding:10px 12px;overflow-x:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{flex-shrink:0;padding:9px 16px;border-radius:20px;background:rgba(59,130,246,.08);border:1px solid var(--b);color:#93c5fd;font-size:12px;font-weight:800;cursor:pointer;font-family:inherit;white-space:nowrap}
.tab.active{background:linear-gradient(135deg,#3b82f6,#2563eb);color:#fff;border-color:transparent}
main{padding:8px 16px}
.search{margin-bottom:12px}
.search input{width:100%;padding:12px 16px;border-radius:12px;border:1px solid var(--b);background:rgba(0,0,0,.3);color:#fff;font-family:inherit;font-size:13px;box-sizing:border-box}
.search input:focus{outline:none;border-color:#3b82f6}
.bk-card{background:linear-gradient(135deg,var(--s),var(--s2));border:1px solid var(--b);border-radius:16px;padding:14px;margin-bottom:12px}
.bk-card.pending{border-color:rgba(245,158,11,.5)}
.bk-card.confirmed{border-color:rgba(34,197,94,.4)}
.bk-card.completed{border-color:rgba(59,130,246,.4);opacity:.9}
.bk-card.cancelled{border-color:rgba(239,68,68,.4);opacity:.7}
.bk-head{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;padding-bottom:10px;border-bottom:1px dashed rgba(255,255,255,.08);margin-bottom:10px}
.bk-cust{font-size:13px;font-weight:800;color:#fff}
.bk-phone{font-size:11px;color:#93c5fd;margin-top:2px}
.bk-time{font-size:10px;color:#6b7280;margin-top:2px}
.bk-status{display:inline-block;padding:4px 10px;border-radius:8px;font-size:10px;font-weight:900;white-space:nowrap}
.st-pending{background:rgba(245,158,11,.25);color:#fcd34d}
.st-confirmed{background:rgba(34,197,94,.25);color:#6ee7b7}
.st-completed{background:rgba(59,130,246,.25);color:#93c5fd}
.st-cancelled{background:rgba(239,68,68,.25);color:#fca5a5}
.bk-info{display:grid;gap:5px;margin-bottom:10px}
.bk-row{display:flex;justify-content:space-between;gap:8px;font-size:12px}
.bk-row .l{color:#93c5fd;flex-shrink:0}
.bk-row .v{color:#fff;font-weight:700;text-align:left;word-break:break-word}
.bk-prices{background:rgba(0,0,0,.25);border-radius:10px;padding:10px;margin-bottom:10px;display:grid;grid-template-columns:1fr 1fr;gap:8px}
.bk-price-item{text-align:center}
.bk-price-item .lbl{font-size:9px;color:#93c5fd;font-weight:700;margin-bottom:3px}
.bk-price-item .val{font-size:14px;font-weight:900;color:#fbbf24}
.bk-price-item .val.final{color:#22c55e}
.bk-delivery{display:inline-block;padding:4px 10px;border-radius:8px;font-size:10px;font-weight:900;background:rgba(34,197,94,.15);color:#4ade80;margin-bottom:8px}
.bk-actions{display:flex;gap:6px;flex-wrap:wrap}
.bk-btn{flex:1;min-width:80px;padding:9px;border-radius:9px;border:none;font-weight:900;font-size:11px;cursor:pointer;font-family:inherit;color:#fff}
.btn-wa{background:var(--wa);flex:0 0 auto;padding:9px 12px}
.btn-edit{background:linear-gradient(135deg,#a855f7,#7c3aed)}
.btn-confirm{background:linear-gradient(135deg,#22c55e,#16a34a)}
.btn-complete{background:linear-gradient(135deg,#3b82f6,#2563eb)}
.btn-cancel{background:rgba(239,68,68,.15);color:#f87171;border:1px solid rgba(239,68,68,.3);flex:0 0 auto;padding:9px 12px}
.btn-del{background:rgba(239,68,68,.15);color:#f87171;border:1px solid rgba(239,68,68,.3);flex:0 0 auto;padding:9px 12px}
.bottom-nav{position:fixed;bottom:0;left:0;right:0;background:rgba(10,8,37,.98);backdrop-filter:blur(12px);border-top:1px solid var(--b);padding:8px 0 max(8px,env(safe-area-inset-bottom));display:flex;justify-content:space-around;z-index:100}
.nav-btn{background:none;border:none;color:#4b5563;font-family:inherit;font-size:10px;font-weight:700;cursor:pointer;padding:6px 10px;display:flex;flex-direction:column;align-items:center;gap:3px;position:relative}
.nav-btn .ic{font-size:22px;filter:grayscale(1)}
.nav-btn.active{color:#3b82f6}
.nav-btn.active .ic{filter:grayscale(0);transform:scale(1.1)}
.fab{position:fixed;bottom:100px;left:20px;width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;border:none;font-size:28px;font-weight:900;cursor:pointer;box-shadow:0 8px 24px rgba(34,197,94,.5);z-index:60;display:flex;align-items:center;justify-content:center}
.modal-ov{position:fixed;inset:0;background:rgba(0,0,0,.85);backdrop-filter:blur(8px);z-index:1000;display:flex;align-items:flex-end}
.modal{background:linear-gradient(180deg,#1a0f3d,#0a0825);width:100%;max-width:520px;margin:0 auto;border-radius:24px 24px 0 0;padding:20px;max-height:92vh;overflow-y:auto;border-top:1px solid rgba(59,130,246,.3)}
.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;padding-bottom:12px;border-bottom:1px solid var(--b)}
.modal-head h3{font-size:17px;font-weight:900;color:#fff}
.modal-close{background:rgba(239,68,68,.15);color:#fca5a5;border:none;width:36px;height:36px;border-radius:50%;font-size:18px;cursor:pointer;font-family:inherit}
.form-field{margin-bottom:10px}
.form-field label{display:block;font-size:11px;font-weight:700;color:#93c5fd;margin-bottom:5px}
.form-field input,.form-field textarea,.form-field select{width:100%;padding:11px 12px;border-radius:10px;border:1px solid var(--b);background:rgba(0,0,0,.3);color:#fff;font-family:inherit;font-size:13px;box-sizing:border-box}
.form-field input:focus,.form-field textarea:focus,.form-field select:focus{outline:none;border-color:#3b82f6}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.toggle-row{display:flex;justify-content:space-between;align-items:center;padding:10px 12px;background:rgba(0,0,0,.25);border-radius:10px;margin-bottom:10px}
.toggle-row .lbl{font-size:13px;font-weight:800;color:#fff}
.toggle-switch{position:relative;width:44px;height:24px;background:#374151;border-radius:12px;cursor:pointer;transition:background .2s}
.toggle-switch.on{background:#22c55e}
.toggle-switch::after{content:'';position:absolute;top:3px;left:3px;width:18px;height:18px;background:#fff;border-radius:50%;transition:left .2s}
.toggle-switch.on::after{left:23px}
.btn-save{width:100%;padding:14px;border-radius:10px;background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;border:none;font-weight:900;font-size:14px;cursor:pointer;font-family:inherit;margin-top:10px}
.empty{text-align:center;padding:60px 20px;color:#4b5563;font-size:14px}
.empty .ic{font-size:56px;margin-bottom:12px;opacity:.4;display:block}
#toasts{position:fixed;bottom:100px;left:50%;transform:translateX(-50%);z-index:3000;display:flex;flex-direction:column;gap:6px;align-items:center;pointer-events:none;width:90%;max-width:400px}
.toast{padding:12px 22px;border-radius:30px;font-weight:800;font-size:13px;color:#fff;box-shadow:0 8px 24px rgba(0,0,0,.5);text-align:center;width:100%}
.toast.ok{background:#22c55e}.toast.err{background:#ef4444}.toast.info{background:#3b82f6}.toast.warn{background:#f59e0b}
.spinner{width:36px;height:36px;border:3px solid rgba(59,130,246,.2);border-top-color:#3b82f6;border-radius:50%;animation:spin .8s linear infinite;margin:40px auto 12px}
@keyframes spin{to{transform:rotate(360deg)}}
</style>
</head>
<body>

<div id="app">
  <header>
    <div class="left">
      <div class="avatar" id="u-avatar">?</div>
      <div style="min-width:0"><div class="h-name" id="u-name">—</div><div class="h-role">مدير الحجوزات</div></div>
    </div>
    <button id="logout-btn" onclick="doLogout()">🚪</button>
  </header>

  <!-- HOME -->
  <div id="v-home" class="view active">
    <div class="home-wrap">
      <div class="welcome">
        <div class="w-greet" id="greet">👋 مرحباً</div>
        <div class="w-sub" id="greet-sub">—</div>
        <div class="w-stats">
          <div class="w-stat"><div class="v" id="s-total">0</div><div class="l">إجمالي</div></div>
          <div class="w-stat"><div class="v" id="s-pending">0</div><div class="l">معلقة</div></div>
          <div class="w-stat"><div class="v" id="s-today">0</div><div class="l">اليوم</div></div>
        </div>
      </div>
      <div class="section-title">🛎️ الخدمات</div>
      <div class="services-grid">
        <div class="svc-card" onclick="goTab('bus')"><div class="ic">🚌</div><div class="lbl">باص سفر</div><div class="cnt hidden" id="cnt-bus">0</div></div>
        <div class="svc-card" onclick="goTab('flight')"><div class="ic">✈️</div><div class="lbl">طيران</div><div class="cnt hidden" id="cnt-flight">0</div></div>
        <div class="svc-card" onclick="goTab('hajj')"><div class="ic">🕋</div><div class="lbl">حج</div><div class="cnt hidden" id="cnt-hajj">0</div></div>
        <div class="svc-card" onclick="goTab('umrah')"><div class="ic">🕌</div><div class="lbl">عمرة</div><div class="cnt hidden" id="cnt-umrah">0</div></div>
      </div>
    </div>
  </div>

  <!-- TAB VIEWS -->
  <div id="v-bus" class="view"><div class="tabs"><button class="tab active" data-filter="all">📊 الكل</button><button class="tab" data-filter="pending">⏳ معلقة</button><button class="tab" data-filter="confirmed">✅ مؤكدة</button><button class="tab" data-filter="completed">🏁 مكتملة</button></div><div class="search"><input placeholder="🔍 بحث بالاسم أو الهاتف" oninput="renderTab('bus')"></div><main id="list-bus"></main></div>
  <div id="v-flight" class="view"><div class="tabs"><button class="tab active" data-filter="all">📊 الكل</button><button class="tab" data-filter="pending">⏳ معلقة</button><button class="tab" data-filter="confirmed">✅ مؤكدة</button><button class="tab" data-filter="completed">🏁 مكتملة</button></div><div class="search"><input placeholder="🔍 بحث" oninput="renderTab('flight')"></div><main id="list-flight"></main></div>
  <div id="v-hajj" class="view"><div class="tabs"><button class="tab active" data-filter="all">📊 الكل</button><button class="tab" data-filter="pending">⏳ معلقة</button><button class="tab" data-filter="confirmed">✅ مؤكدة</button><button class="tab" data-filter="completed">🏁 مكتملة</button></div><div class="search"><input placeholder="🔍 بحث" oninput="renderTab('hajj')"></div><main id="list-hajj"></main></div>
  <div id="v-umrah" class="view"><div class="tabs"><button class="tab active" data-filter="all">📊 الكل</button><button class="tab" data-filter="pending">⏳ معلقة</button><button class="tab" data-filter="confirmed">✅ مؤكدة</button><button class="tab" data-filter="completed">🏁 مكتملة</button></div><div class="search"><input placeholder="🔍 بحث" oninput="renderTab('umrah')"></div><main id="list-umrah"></main></div>

  <nav class="bottom-nav">
    <button class="nav-btn active" onclick="goTab('home')"><span class="ic">🏠</span><span>الرئيسية</span></button>
    <button class="nav-btn" onclick="goTab('bus')"><span class="ic">🚌</span><span>باص</span></button>
    <button class="nav-btn" onclick="goTab('flight')"><span class="ic">✈️</span><span>طيران</span></button>
    <button class="nav-btn" onclick="goTab('hajj')"><span class="ic">🕋</span><span>حج</span></button>
    <button class="nav-btn" onclick="goTab('umrah')"><span class="ic">🕌</span><span>عمرة</span></button>
  </nav>

  <button class="fab hidden" id="fab-add" onclick="openAddForm()">＋</button>
</div>

<div id="form-modal" class="modal-ov hidden" onclick="if(event.target===this)closeFormModal()">
  <div class="modal">
    <div class="modal-head"><h3 id="form-title">➕ إضافة حجز</h3><button class="modal-close" onclick="closeFormModal()">✕</button></div>
    <div id="form-body"></div>
  </div>
</div>

<div id="toasts"></div>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<script src="firebase-config.js"></script>
<script>
(function(){
'use strict';
if(!firebase.apps.length) firebase.initializeApp(window.FIREBASE_CONFIG);
var auth = firebase.auth();
var db = firebase.firestore();
var state = { user:null, userData:null, bookings:[], tab:'home', unsub:null, editingId:null };

var TYPES = {
  bus:{label:'🚌 باص', icon:'🚌', color:'#22c55e'},
  flight:{label:'✈️ طيران', icon:'✈️', color:'#3b82f6'},
  hajj:{label:'🕋 حج', icon:'🕋', color:'#f59e0b'},
  umrah:{label:'🕌 عمرة', icon:'🕌', color:'#a855f7'}
};

function esc(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function toast(m,t){t=t||'info';var c=document.getElementById('toasts');var el=document.createElement('div');el.className='toast '+t;el.textContent=m;c.appendChild(el);setTimeout(()=>{el.style.opacity='0';el.style.transition='opacity .3s';setTimeout(()=>el.remove(),300);},3500);}
function fmtDate(ts){if(!ts)return '—';var d=ts.seconds?new Date(ts.seconds*1000):new Date(ts);return d.toLocaleString('ar-YE',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});}
function isToday(ts){if(!ts)return false;var d=ts.seconds?new Date(ts.seconds*1000):new Date(ts);return d.toDateString()===new Date().toDateString();}

auth.onAuthStateChanged(async function(u){
  if(!u){ location.href='bookings-login.html'; return; }
  try {
    var udoc = await db.collection('users').doc(u.uid).get();
    var role = udoc.exists ? (udoc.data().role||'') : '';
    if(role !== 'bookings_mgr'){ await auth.signOut(); location.href='bookings-login.html'; return; }
    state.user = u;
    state.userData = udoc.data();
    document.getElementById('u-name').textContent = state.userData.name || u.email;
    document.getElementById('u-avatar').textContent = (state.userData.name||u.email||'م').charAt(0);
    var hr = new Date().getHours();
    document.getElementById('greet').textContent = hr<12?'☀️ صباح الخير':hr<17?'🌤️ مساء الخير':'🌙 مساء الخير';
    document.getElementById('greet-sub').textContent = 'مرحباً ' + ((state.userData.name||'').split(' ')[0] || '') + ' — إليك ملخص الحجوزات';
    startListener();
  } catch(e){ toast('❌ '+e.message,'err'); await auth.signOut(); location.href='bookings-login.html'; }
});

function startListener(){
  if(state.unsub) state.unsub();
  state.unsub = db.collection('bookings').orderBy('createdAt','desc').limit(500).onSnapshot(function(snap){
    var arr = [];
    snap.forEach(function(d){ arr.push(Object.assign({id:d.id}, d.data())); });
    state.bookings = arr;
    render();
  }, function(err){ toast('❌ '+err.message,'err'); });
}

window.goTab = function(tab){
  state.tab = tab;
  document.querySelectorAll('.view').forEach(function(v){ v.classList.remove('active'); });
  var target = document.getElementById('v-'+tab);
  if(target) target.classList.add('active');
  document.querySelectorAll('.nav-btn').forEach(function(b,i){
    var labels = ['home','bus','flight','hajj','umrah'];
    b.classList.toggle('active', labels[i] === tab);
  });
  document.getElementById('fab-add').classList.toggle('hidden', tab === 'home');
  if(tab !== 'home') renderTab(tab);
  else renderHome();
};

function render(){
  if(state.tab === 'home') renderHome();
  else renderTab(state.tab);
}

function renderHome(){
  var total = state.bookings.length;
  var pending = state.bookings.filter(function(b){ return b.status === 'pending'; }).length;
  var today = state.bookings.filter(function(b){ return isToday(b.createdAt); }).length;
  document.getElementById('s-total').textContent = total;
  document.getElementById('s-pending').textContent = pending;
  document.getElementById('s-today').textContent = today;
  
  ['bus','flight','hajj','umrah'].forEach(function(t){
    var cnt = state.bookings.filter(function(b){ return b.type === t && b.status === 'pending'; }).length;
    var badge = document.getElementById('cnt-'+t);
    if(cnt > 0){ badge.textContent = cnt; badge.classList.remove('hidden'); } else badge.classList.add('hidden');
  });
}

function renderTab(type){
  var el = document.getElementById('list-'+type);
  if(!el) return;
  var activeChip = document.querySelector('#v-'+type+' .tab.active');
  var filter = activeChip ? activeChip.dataset.filter : 'all';
  var searchInput = document.querySelector('#v-'+type+' .search input');
  var search = searchInput ? searchInput.value.toLowerCase().trim() : '';
  
  var list = state.bookings.filter(function(b){ return b.type === type; });
  if(filter !== 'all') list = list.filter(function(b){ return b.status === filter; });
  if(search) list = list.filter(function(b){
    var nm = (b.userName||'').toLowerCase();
    var ph = (b.phone||b.userPhone||(b.data&&b.data.phone)||'').toLowerCase();
    return nm.includes(search) || ph.includes(search);
  });
  
  if(!list.length){
    el.innerHTML = '<div class="empty"><span class="ic">'+TYPES[type].icon+'</span>لا توجد حجوزات</div>';
    return;
  }
  
  el.innerHTML = list.map(function(b){ return renderBookingCard(b); }).join('');
  
  // Bind actions
  el.querySelectorAll('[data-act]').forEach(function(btn){
    btn.onclick = function(e){
      e.stopPropagation();
      var act = btn.dataset.act;
      var id = btn.dataset.id;
      if(act === 'confirm') changeStatus(id, 'confirmed');
      else if(act === 'complete') changeStatus(id, 'completed');
      else if(act === 'cancel') changeStatus(id, 'cancelled');
      else if(act === 'edit') openEditForm(id);
      else if(act === 'delete') deleteBooking(id);
    };
  });
  
  // Bind filter chips
  document.querySelectorAll('#v-'+type+' .tab').forEach(function(t){
    t.onclick = function(){
      document.querySelectorAll('#v-'+type+' .tab').forEach(function(x){ x.classList.remove('active'); });
      t.classList.add('active');
      renderTab(type);
    };
  });
}

function renderBookingCard(b){
  var d = b.data || {};
  var typeInfo = TYPES[b.type] || {label:b.type, icon:'📄'};
  var phone = b.phone || b.userPhone || d.phone || '';
  var stLbl = {pending:'⏳ معلقة', confirmed:'✅ مؤكدة', completed:'🏁 مكتملة', cancelled:'❌ ملغاة'}[b.status] || b.status;
  var est = Number(b.estimatedPrice) || 0;
  var fin = Number(b.finalPrice) || 0;
  var hasDelivery = b.freeDelivery || d.freeDelivery;
  var deliveryAddr = b.deliveryAddress || d.deliveryAddress || d.address || '';
  
  var details = '';
  if(b.type === 'bus'){
    details += row('من', d.from || '—');
    details += row('إلى', d.to || '—');
    details += row('التاريخ', d.date || '—');
    details += row('الركاب', d.passengers || '1');
    if(d.busType) details += row('نوع الباص', d.busType);
  } else if(b.type === 'flight'){
    details += row('من', d.from || '—');
    details += row('إلى', d.to || '—');
    details += row('التاريخ', d.date || '—');
    if(d.returnDate) details += row('العودة', d.returnDate);
    details += row('المسافرون', d.passengers || '1');
    if(d.airline) details += row('الشركة', d.airline);
  } else if(b.type === 'hajj' || b.type === 'umrah'){
    if(d.packageName) details += row('الباقة', d.packageName);
    details += row('التاريخ', d.date || d.year || '—');
    details += row('عدد الأشخاص', d.passengers || '1');
    if(d.roomType) details += row('نوع الغرفة', d.roomType);
    if(d.duration) details += row('المدة', d.duration + ' أيام');
  }
  if(d.notes) details += row('ملاحظات', d.notes);
  
  var html = '<div class="bk-card '+b.status+'">';
  html += '<div class="bk-head"><div style="min-width:0;flex:1">';
  html += '<div class="bk-cust">' + typeInfo.icon + ' ' + esc(b.userName || 'عميل') + '</div>';
  if(phone) html += '<div class="bk-phone">📱 ' + esc(phone) + '</div>';
  html += '<div class="bk-time">🕐 ' + fmtDate(b.createdAt) + '</div>';
  html += '</div><div class="bk-status st-' + b.status + '">' + stLbl + '</div></div>';
  
  html += '<div class="bk-info">' + details + '</div>';
  
  if(est > 0 || fin > 0){
    html += '<div class="bk-prices">';
    html += '<div class="bk-price-item"><div class="lbl">💰 تقريبي</div><div class="val">' + est + ' ر</div></div>';
    html += '<div class="bk-price-item"><div class="lbl">✅ نهائي</div><div class="val final">' + fin + ' ر</div></div>';
    html += '</div>';
  }
  
  if(hasDelivery){
    html += '<div class="bk-delivery">🚚 توصيل مجاني' + (deliveryAddr ? ' — ' + esc(deliveryAddr) : '') + '</div>';
  }
  
  html += '<div class="bk-actions">';
  if(phone) html += '<a href="https://wa.me/' + phone.replace(/\D/g,'') + '" target="_blank" class="bk-btn btn-wa">💬</a>';
  html += '<button class="bk-btn btn-edit" data-act="edit" data-id="' + b.id + '">✏️ تعديل</button>';
  if(b.status === 'pending') html += '<button class="bk-btn btn-confirm" data-act="confirm" data-id="' + b.id + '">✅ تأكيد</button>';
  if(b.status === 'confirmed') html += '<button class="bk-btn btn-complete" data-act="complete" data-id="' + b.id + '">🏁 إكمال</button>';
  html += '<button class="bk-btn btn-del" data-act="delete" data-id="' + b.id + '">🗑</button>';
  html += '</div></div>';
  return html;
}

function row(l, v){ return '<div class="bk-row"><span class="l">' + l + ':</span><span class="v">' + esc(v) + '</span></div>'; }

async function changeStatus(id, status){
  var labels = {confirmed:'تأكيد', completed:'إكمال', cancelled:'إلغاء'};
  if(!confirm(labels[status] + ' هذا الحجز؟')) return;
  try {
    var upd = {status: status, updatedAt: firebase.firestore.FieldValue.serverTimestamp()};
    if(status === 'confirmed') upd.confirmedAt = firebase.firestore.FieldValue.serverTimestamp();
    if(status === 'completed') upd.completedAt = firebase.firestore.FieldValue.serverTimestamp();
    if(status === 'cancelled') upd.cancelledAt = firebase.firestore.FieldValue.serverTimestamp();
    await db.collection('bookings').doc(id).update(upd);
    toast('✅ تم ' + labels[status], 'ok');
  } catch(e){ toast('❌ ' + e.message, 'err'); }
}

async function deleteBooking(id){
  if(!confirm('⚠️ حذف الحجز نهائياً؟')) return;
  try { await db.collection('bookings').doc(id).delete(); toast('✅ تم الحذف', 'ok'); }
  catch(e){ toast('❌ ' + e.message, 'err'); }
}

window.openAddForm = function(){ state.editingId = null; showFormModal(state.tab !== 'home' ? state.tab : 'bus', null); };
window.openEditForm = function(id){
  var b = state.bookings.find(function(x){ return x.id === id; });
  if(!b) return;
  state.editingId = id;
  showFormModal(b.type, b);
};
window.closeFormModal = function(){ document.getElementById('form-modal').classList.add('hidden'); };

function showFormModal(type, existing){
  var b = existing || {data:{}};
  var d = b.data || {};
  var isEdit = !!existing;
  document.getElementById('form-title').textContent = isEdit ? '✏️ تعديل الحجز' : '➕ إضافة حجز';
  
  var typeInfo = TYPES[type];
  var html = '';
  
  if(!isEdit){
    html += '<div class="form-field"><label>نوع الحجز</label><select id="f-type" onchange="showFormModal(this.value, null)">';
    Object.keys(TYPES).forEach(function(k){
      html += '<option value="' + k + '"' + (k === type ? ' selected' : '') + '>' + TYPES[k].label + '</option>';
    });
    html += '</select></div>';
  } else {
    html += '<div class="form-field"><label>النوع</label><input value="' + typeInfo.label + '" disabled style="opacity:.6"></div>';
  }
  
  html += '<div class="form-field"><label>اسم العميل *</label><input id="f-name" value="' + esc(b.userName || '') + '" placeholder="اسم العميل"></div>';
  html += '<div class="form-field"><label>رقم الهاتف *</label><input id="f-phone" type="tel" value="' + esc(b.phone || d.phone || '') + '" placeholder="77xxxxxxx"></div>';
  
  if(type === 'bus' || type === 'flight'){
    html += '<div class="form-row">';
    html += '<div class="form-field"><label>من *</label><input id="f-from" value="' + esc(d.from || '') + '"></div>';
    html += '<div class="form-field"><label>إلى *</label><input id="f-to" value="' + esc(d.to || '') + '"></div>';
    html += '</div>';
    html += '<div class="form-row">';
    html += '<div class="form-field"><label>التاريخ</label><input id="f-date" type="date" value="' + esc(d.date || '') + '"></div>';
    html += '<div class="form-field"><label>عدد الركاب</label><input id="f-passengers" type="number" min="1" value="' + (d.passengers || 1) + '"></div>';
    html += '</div>';
    if(type === 'flight'){
      html += '<div class="form-field"><label>شركة الطيران</label><input id="f-airline" value="' + esc(d.airline || '') + '"></div>';
    } else {
      html += '<div class="form-field"><label>نوع الباص</label><input id="f-bustype" value="' + esc(d.busType || '') + '" placeholder="VIP / عادي"></div>';
    }
  } else {
    html += '<div class="form-field"><label>اسم الباقة</label><input id="f-package" value="' + esc(d.packageName || '') + '"></div>';
    html += '<div class="form-row">';
    html += '<div class="form-field"><label>التاريخ/السنة</label><input id="f-date" value="' + esc(d.date || d.year || '') + '"></div>';
    html += '<div class="form-field"><label>عدد الأشخاص</label><input id="f-passengers" type="number" min="1" value="' + (d.passengers || 1) + '"></div>';
    html += '</div>';
    html += '<div class="form-field"><label>نوع الغرفة</label><input id="f-room" value="' + esc(d.roomType || '') + '" placeholder="مشترك / مزدوج / فردي"></div>';
  }
  
  html += '<div class="form-field"><label>ملاحظات</label><textarea id="f-notes">' + esc(d.notes || '') + '</textarea></div>';
  
  // Delivery
  var hasDel = b.freeDelivery || d.freeDelivery;
  html += '<div class="toggle-row"><span class="lbl">🚚 توصيل مجاني</span><div class="toggle-switch ' + (hasDel?'on':'') + '" id="f-delivery-toggle" onclick="toggleDelivery()"></div></div>';
  html += '<div class="form-field" id="f-delivery-addr-wrap" style="' + (hasDel?'':'display:none') + '"><label>عنوان التوصيل</label><input id="f-delivery-addr" value="' + esc(b.deliveryAddress || d.deliveryAddress || '') + '"></div>';
  
  // Prices
  html += '<div class="form-row">';
  html += '<div class="form-field"><label>💰 السعر التقريبي</label><input id="f-estprice" type="number" min="0" value="' + (b.estimatedPrice || 0) + '"></div>';
  html += '<div class="form-field"><label>✅ السعر النهائي</label><input id="f-finprice" type="number" min="0" value="' + (b.finalPrice || 0) + '"></div>';
  html += '</div>';
  
  html += '<button class="btn-save" onclick="saveBooking(\'' + type + '\')">💾 حفظ</button>';
  
  document.getElementById('form-body').innerHTML = html;
  document.getElementById('form-modal').classList.remove('hidden');
}

window.toggleDelivery = function(){
  var t = document.getElementById('f-delivery-toggle');
  var w = document.getElementById('f-delivery-addr-wrap');
  t.classList.toggle('on');
  w.style.display = t.classList.contains('on') ? 'block' : 'none';
};

window.saveBooking = async function(type){
  var name = document.getElementById('f-name').value.trim();
  var phone = document.getElementById('f-phone').value.trim();
  if(!name || !phone){ toast('❌ الاسم والهاتف مطلوبان', 'err'); return; }
  
  var data = {};
  var from = document.getElementById('f-from');
  var to = document.getElementById('f-to');
  var date = document.getElementById('f-date');
  var passengers = document.getElementById('f-passengers');
  var airline = document.getElementById('f-airline');
  var bustype = document.getElementById('f-bustype');
  var pkg = document.getElementById('f-package');
  var room = document.getElementById('f-room');
  var notes = document.getElementById('f-notes');
  
  if(from) data.from = from.value.trim();
  if(to) data.to = to.value.trim();
  if(date) data.date = date.value;
  if(passengers) data.passengers = Number(passengers.value) || 1;
  if(airline) data.airline = airline.value.trim();
  if(bustype) data.busType = bustype.value.trim();
  if(pkg) data.packageName = pkg.value.trim();
  if(room) data.roomType = room.value.trim();
  if(notes) data.notes = notes.value.trim();
  
  var hasDel = document.getElementById('f-delivery-toggle').classList.contains('on');
  var delAddr = document.getElementById('f-delivery-addr');
  var est = Number(document.getElementById('f-estprice').value) || 0;
  var fin = Number(document.getElementById('f-finprice').value) || 0;
  
  var booking = {
    type: type,
    userName: name,
    phone: phone,
    data: data,
    freeDelivery: hasDel,
    deliveryAddress: hasDel && delAddr ? delAddr.value.trim() : '',
    estimatedPrice: est,
    finalPrice: fin,
    updatedAt: firebase.firestore.FieldValue.serverTimestamp(),
    updatedBy: state.user.uid
  };
  
  try {
    if(state.editingId){
      await db.collection('bookings').doc(state.editingId).update(booking);
      toast('✅ تم حفظ التعديلات', 'ok');
    } else {
      booking.status = 'pending';
      booking.userId = state.user.uid;
      booking.userEmail = state.user.email;
      booking.createdAt = firebase.firestore.FieldValue.serverTimestamp();
      booking.createdBy = state.user.uid;
      await db.collection('bookings').add(booking);
      toast('✅ تم إضافة الحجز', 'ok');
    }
    closeFormModal();
    if(state.tab !== 'home' && state.tab !== type) goTab(type);
  } catch(e){ toast('❌ ' + e.message, 'err'); }
};

window.doLogout = function(){
  if(!confirm('تسجيل الخروج؟')) return;
  if(state.unsub) state.unsub();
  auth.signOut().then(function(){ location.href='bookings-login.html'; });
};
})();
</script>
