async function editProduct(id) {
  try {
    var doc = await db.collection('products').doc(id).get();
    if (!doc.exists) { alert('المنتج غير موجود'); return; }
    var p = doc.data();
    p.id = doc.id;
    closeProductsView();
    await openProductModal(p);
  } catch(e) { alert('❌ ' + e.message); }
}

async function toggleProduct(id) {
  try {
    var doc = await db.collection('products').doc(id).get();
    if (!doc.exists) { alert('المنتج غير موجود'); return; }
    var p = doc.data();
    var isLive = p.status === 'live' || p.active === true;
    var newState = !isLive;
    await db.collection('products').doc(id).update({
      active: newState,
      isActive: newState,
      status: newState ? 'live' : 'pending_review'
    });
    alert(newState ? '✅ تم إظهار المنتج' : '👁️ تم إخفاء المنتج');
    await loadProductsList();
    renderProductsView();
  } catch(e) { alert('❌ ' + e.message); }
}

async function deleteProduct(id) {
  if (!confirm('⚠️ حذف المنتج نهائياً؟ لا يمكن التراجع.')) return;
  try {
    await db.collection('products').doc(id).delete();
    alert('🗑️ تم حذف المنتج');
    await loadProductsList();
    renderProductsView();
  } catch(e) { alert('❌ ' + e.message); }
}


