</div>

<!-- Latest Orders -->
<div class="section">
  <div class="section-title">
    <h3>📋 آخر الطلبات</h3>
    <a href="#" onclick="alert('عرض الكل (قيد التطوير)')">عرض الكل ←</a>
  </div>
  <div class="card" id="ordersContainer">
    <div class="loading">⏳ جاري التحميل...</div>
  </div>
</div>

<!-- Bottom Nav -->
<div class="bottom-nav">
  <div class="nav-item" onclick="alert('الإشعارات (قيد التطوير)')" style="position:relative;">
    <div class="icon">🔔</div>
    <div class="label">الإشعارات</div>
    <span class="nav-badge">2</span>
  </div>
  <div class="nav-item active home">
    <div class="icon">🏠</div>
    <div class="label">الرئيسية</div>
  </div>
  <div class="nav-item" onclick="alert('التقارير (قيد التطوير)')">
    <div class="icon">📊</div>
    <div class="label">التقارير</div>
  </div>
  <div class="nav-item" onclick="alert('الإعدادات (قيد التطوير)')">
    <div class="icon">⚙️</div>
    <div class="label">الإعدادات</div>
  </div>
</div>

<script>
'use strict';
// Initialize Firebase
if (!firebase.apps.length) {
  if (window.FIREBASE_CONFIG) {
    firebase.initializeApp(window.FIREBASE_CONFIG);
  } else {
    console.error('FIREBASE_CONFIG not found!');
    document.getElementById('catName').textContent = 'خطأ: FIREBASE_CONFIG غير موجود';
  }
}

var auth = firebase.auth();
var db = firebase.firestore();
var state = { user: null, userData: {}, cat: null, orders: [], products: [] };

function catLabel(c) {
  var labels = { fashion:'أزياء وموضة', shoes:'أحذية', perfume:'عطور', electronics:'إلكترونيات', accessories:'إكسسوارات', kids:'أطفال', supermarket:'سوبر ماركت', home:'منزل وأثاث', beauty:'جمال' };
  return labels[c] || c || '—';
}

function esc(s) { return String(s||'').replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }

function showLoading() {
  document.getElementById('ordersContainer').innerHTML = '<div class="loading">⏳ جاري التحميل...</div>';
}

function showError(msg) {
  document.getElementById('ordersContainer').innerHTML = '<div class="loading" style="color:#ef4444;">❌ ' + msg + '</div>';
}

async function loadUserData(user) {
  var udoc = await db.collection('users').doc(user.uid).get();
  state.userData = udoc.exists ? udoc.data() : {};
  state.cat = state.userData.category || state.userData.cat || null;
  
  if (!state.cat) {
    var _mc = prompt('اختر رقم القسم: 1=fashion, 2=electronics, 3=perfume, 4=shoes'); var _map={'1':'fashion','2':'electronics','3':'perfume','4':'shoes'}; if(_mc && _map[_mc]) { state.cat = _map[_mc]; localStorage.setItem('chz_cat_manager_cat', state.cat); document.getElementById('catName').textContent = 'قسم: ' + catLabel(state.cat); return true; } else { document.getElementById('catName').textContent = '⚠️ لم يتم تعيين قسم'; }
    return false;
  }
  
  document.getElementById('catName').textContent = 'قسم: ' + catLabel(state.cat);
  return true;
}

async function loadOrders() {
  try {
    var snap = await db.collection('orders').limit(100).get();
    state.orders = [];
    snap.forEach(function(d) {
      var x = d.data();
      x.id = d.id;
      // فلترة: طلبات تحتوي على منتجات من هذا القسم
      var inCat = false;
      if (x.category === state.cat) inCat = true;
      if (x.categories && x.categories[state.cat]) inCat = true;
      if (inCat) state.orders.push(x);
    });
    state.orders.sort(function(a, b) {
      var ta = a.createdAt ? (a.createdAt.seconds || 0) : 0;
      var tb = b.createdAt ? (b.createdAt.seconds || 0) : 0;
      return tb - ta;
    });
    console.log('[loadOrders] cat=' + state.cat + ' total=' + snap.size + ' matched=' + state.orders.length);
  } catch(e) { console.error('[orders]', e); }
}

async function loadProducts() {
  try {
    var snap = await db.collection('products').get();
    var all = [];
    snap.forEach(function(d) { var x = d.data(); x.id = d.id; all.push(x); });
    var cat = (state.cat || '').toLowerCase().trim();
    state.products = all.filter(function(p) {
      var pc = (p.category || '').toLowerCase().trim();
      var pcs = Array.isArray(p.categories) ? p.categories.map(function(c){ return (c||'').toLowerCase().trim(); }) : [];
      return pc === cat || pcs.indexOf(cat) !== -1;
    });
  } catch(e) { console.error('[products]', e); }
}

function renderStats() {
  var newOrders = state.orders.filter(function(o) { return o.status === 'pending' || o.status === 'awaiting_verification'; }).length;
  var doneOrders = state.orders.filter(function(o) { return o.status === 'completed' || o.status === 'delivered'; }).length;
  var prepOrders = state.orders.filter(function(o) { return o.status === 'confirmed' || o.status === 'processing' || o.status === 'preparing'; }).length;
  
  document.getElementById('statNew').textContent = newOrders;
  document.getElementById('statDone').textContent = doneOrders;
  document.getElementById('statPrep').textContent = prepOrders;
  
  console.log('[stats] new=' + newOrders + ' done=' + doneOrders + ' prep=' + prepOrders);
}

function renderLatestOrders() {
  var latest = state.orders.slice(0, 3);
  var container = document.getElementById('ordersContainer');
  
  if (!latest.length) {
    container.innerHTML = '<div style="text-align:center;padding:30px 20px;color:#9ca3af;"><div style="font-size:48px;margin-bottom:8px;">📭</div><b style="font-size:14px;color:#6b7280;">لا توجد طلبات</b><br><small style="font-size:11px;">ستظهر الطلبات هنا</small></div>';
    return;
  }
  
  container.innerHTML = latest.map(function(o) {
    var statusClass = 'pending';
    var statusLabel = '⏳ معلق';
    if (o.status === 'completed' || o.status === 'delivered') { statusClass = 'completed'; statusLabel = '🏁 مكتمل'; }
    else if (o.status === 'confirmed' || o.status === 'processing') { statusClass = 'confirmed'; statusLabel = '✅ مؤكد'; }
    
    var initial = (o.customerName || o.name || '؟').charAt(0);
    var orderId = (o.id || '').substring(0, 8);
    var total = Number(o.total) || 0;
    var timeAgo = '';
    if (o.createdAt && o.createdAt.seconds) {
      var diff = Math.floor((Date.now()/1000) - o.createdAt.seconds);
      if (diff < 60) timeAgo = 'الآن';
      else if (diff < 3600) timeAgo = Math.floor(diff/60) + ' دقيقة';
      else if (diff < 86400) timeAgo = Math.floor(diff/3600) + ' ساعة';
      else timeAgo = Math.floor(diff/86400) + ' يوم';
    }
    
    return '<div class="order-row">' +
      '<div class="order-avatar">' + esc(initial) + '</div>' +
      '<div class="order-info">' +
        '<div class="name">' + esc(o.customerName || o.name || 'عميل') + '</div>' +
        '<div class="id">#' + esc(orderId) + ' • ' + total.toFixed(0) + ' ر.ي' + (timeAgo ? ' • ' + timeAgo : '') + '</div>' +
      '</div>' +
      '<div class="order-status ' + statusClass + '">' + statusLabel + '</div>' +
    '</div>';
  }).join('');
}

auth.onAuthStateChanged(async function(user) {
  console.log('[AUTH] user:', user ? user.uid : 'null');
  if (!user) {
    document.getElementById('catName').textContent = 'غير مسجل';
    document.getElementById('ordersContainer').innerHTML = 
      '<div style="text-align:center;padding:30px;">' +
        '<div style="font-size:48px;margin-bottom:12px;">🔒</div>' +
        '<div style="font-size:14px;font-weight:800;color:#6b7280;margin-bottom:16px;">سجّل الدخول لعرض بياناتك</div>' +
        '<a href="cat-login.html" style="display:inline-block;padding:14px 28px;background:linear-gradient(135deg,#a855f7,#ec4899);color:#fff;border-radius:12px;text-decoration:none;font-weight:900;font-size:14px;">🔑 تسجيل الدخول</a>' +
      '</div>';
    return;
  }
  if (!user) {
    document.getElementById('catName').textContent = 'سجّل الدخول أولاً';
    document.getElementById('ordersContainer').innerHTML = '<div class="empty"><i>🔒</i><b>غير مسجل</b><small>سجّل الدخول لعرض البيانات</small></div>';
    return;
  }
  
  state.user = user;
  showLoading();
  
  try {
    var ok = await loadUserData(user);
    if (!ok) {
      document.getElementById('ordersContainer').innerHTML = '<div class="empty"><i>⚠️</i><b>لم يتم تعيين قسم</b><small>تواصل مع الإدارة</small></div>';
      return;
    }
    
    await Promise.all([loadOrders(), loadProducts()]);
    
    renderStats();
    renderLatestOrders();
    
  } catch(e) {
    console.error('[AUTH ERROR]', e);
    document.getElementById('catName').textContent = 'خطأ: ' + (e.message || 'غير معروف').substring(0, 30);
    document.getElementById('ordersContainer').innerHTML = '<div style="text-align:center;padding:20px;color:#ef4444;">❌ خطأ:<br><small>' + (e.message || 'حدث خطأ') + '</small></div>';
  }
});


// ═══ Modal إضافة منتج ═══
var _formImages = [];
var _editingId = null;

async function openProductModal(productData) {
  await loadRates();
  _editingId = productData ? productData.id : null;
  
  var titleEl = document.querySelector('#productModal h2');
  if (titleEl) titleEl.textContent = productData ? '✏️ تعديل المنتج' : '➕ إضافة منتج جديد';
  
  document.getElementById('pf-name').value = productData ? (productData.name || '') : '';
  document.getElementById('pf-brand').value = productData ? (productData.brand || '') : '';
  document.getElementById('pf-sku').value = productData ? (productData.sku || '') : '';
  document.getElementById('pf-desc').value = productData ? (productData.description || '') : '';
  document.getElementById('pf-price').value = productData ? (productData.inputPrice || productData.price || '') : '';
  document.getElementById('pf-currency').value = productData ? (productData.inputCurrency || 'YER') : 'YER';
  document.getElementById('pf-stock').value = productData ? (productData.stock || '') : '';
  
  _formImages = productData && Array.isArray(productData.images) ? productData.images.slice() : [];
  _sizes = productData && Array.isArray(productData.sizes) ? productData.sizes.slice() : [];
  
  document.querySelectorAll('.size-btn').forEach(function(b) {
    var size = b.textContent;
    if (_sizes.indexOf(size) !== -1) {
      b.style.background = '#a855f7';
      b.style.color = '#fff';
      b.style.borderColor = '#a855f7';
    } else {
      b.style.background = '#fff';
      b.style.color = '#1a1a2e';
      b.style.borderColor = '#e5e7eb';
    }
  });
  
  renderImagePreview();
  attachImageInput();
  calculateAutoRates();
  document.getElementById('productModal').style.display = 'block';
}

function closeProductModal() {
  document.getElementById('productModal').style.display = 'none';
}

function attachImageInput() {
  var input = document.getElementById('pf-images-input');
  if (input._attached) return;
  input._attached = true;
  input.onchange = function(e) {
    var files = Array.from(e.target.files || []);
    files.forEach(function(file) {
      if (!file.type.startsWith('image/')) return;
      if (_formImages.length >= 5) return;
      var reader = new FileReader();
      reader.onload = function(ev) {
        var img = new Image();
        img.onload = function() {
          var canvas = document.createElement('canvas');
          var max = 600;
          var w = img.width, h = img.height;
          if (w > max || h > max) {
            if (w > h) { h = Math.round(h * max / w); w = max; }
            else { w = Math.round(w * max / h); h = max; }
          }
          canvas.width = w; canvas.height = h;
          canvas.getContext('2d').drawImage(img, 0, 0, w, h);
          _formImages.push(canvas.toDataURL('image/jpeg', 0.8));
          renderImagePreview();
        };
        img.src = ev.target.result;
      };
      reader.readAsDataURL(file);
    });
    input.value = '';
  };
}

function renderImagePreview() {
  var preview = document.getElementById('pf-images-preview');
  if (!preview) return;
  preview.innerHTML = _formImages.map(function(src, idx) {
    return '<div style="position:relative; padding-top:100%; background:#f3f4f6; border-radius:8px; overflow:hidden;">' +
      '<img src="' + src + '" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;">' +
      '<button onclick="_formImages.splice(' + idx + ',1); renderImagePreview();" style="position:absolute; top:2px; right:2px; background:#ef4444; color:#fff; border:none; width:20px; height:20px; border-radius:50%; font-size:11px; cursor:pointer;">✕</button>' +
    '</div>';
  }).join('');
}

async function saveProduct() {
  var name = document.getElementById('pf-name').value.trim();
  var price = Number(document.getElementById('pf-price').value) || 0;
  var stock = Number(document.getElementById('pf-stock').value) || 0;
  
  if (!name) { alert('❌ أدخل اسم المنتج'); return; }
  if (price <= 0) { alert('❌ أدخل السعر'); return; }
  if (!_formImages.length) { alert('❌ أضف صورة واحدة على الأقل'); return; }
  
  var btn = document.getElementById('saveBtn');
  btn.disabled = true;
  btn.textContent = '⏳ جاري الحفظ...';
  
  try {
