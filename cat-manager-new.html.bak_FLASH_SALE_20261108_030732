function attachImageInput() {
  var input = document.getElementById('pf-images-input');
  if (input._attached) return;
  input._attached = true;
  input.onchange = function(e) {
    var files = Array.from(e.target.files || []);
    files.forEach(function(file) {
      if (!file.type.startsWith('image/')) return;
      if (_formImages.length >= 5) return;
      var reader = new FileReader();
      reader.onload = function(ev) {
        var img = new Image();
        img.onload = function() {
          var canvas = document.createElement('canvas');
          var max = 600;
          var w = img.width, h = img.height;
          if (w > max || h > max) {
            if (w > h) { h = Math.round(h * max / w); w = max; }
            else { w = Math.round(w * max / h); h = max; }
          }
          canvas.width = w; canvas.height = h;
          canvas.getContext('2d').drawImage(img, 0, 0, w, h);
          _formImages.push(canvas.toDataURL('image/jpeg', 0.8));
          renderImagePreview();
        };
        img.src = ev.target.result;
      };
      reader.readAsDataURL(file);
    });
    input.value = '';
  };
}

function renderImagePreview() {
  var preview = document.getElementById('pf-images-preview');
  if (!preview) return;
  preview.innerHTML = _formImages.map(function(src, idx) {
    return '<div style="position:relative; padding-top:100%; background:#f3f4f6; border-radius:8px; overflow:hidden;">' +
      '<img src="' + src + '" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;">' +
      '<button onclick="_formImages.splice(' + idx + ',1); renderImagePreview();" style="position:absolute; top:2px; right:2px; background:#ef4444; color:#fff; border:none; width:20px; height:20px; border-radius:50%; font-size:11px; cursor:pointer;">✕</button>' +
