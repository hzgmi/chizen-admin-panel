var _rates = { sarSouth: 350, usdSouth: 1300, sarNorth: 500, usdNorth: 2000 };

async function loadRates() {
  try {
    var doc = await db.collection('config').doc('rates').get();
    if (doc.exists) {
      var d = doc.data();
      _rates = {
        sarSouth: Number(d.sarSouth) || 350,
        usdSouth: Number(d.usdSouth) || 1300,
        sarNorth: Number(d.sarNorth) || 500,
        usdNorth: Number(d.usdNorth) || 2000
      };
      console.log('[rates] loaded:', _rates);
    }
  } catch(e) {
    console.warn('[rates] failed:', e.message);
  }
}

function calculateAutoRates() {
  var price = parseFloat((document.getElementById('pf-price')||{}).value) || 0;
  var currency = (document.getElementById('pf-currency')||{}).value || 'YER';
  
  var yerEl = document.getElementById('rate-yer');
  var sarEl = document.getElementById('rate-sar');
  var usdEl = document.getElementById('rate-usd');
  
  if (price <= 0) {
    if (yerEl) yerEl.textContent = '—';
    if (sarEl) sarEl.textContent = '—';
    if (usdEl) usdEl.textContent = '—';
    return;
  }
  
  // تحويل السعر إلى اليمني (الأساس)
  var priceYER = price;
  if (currency === 'SAR') priceYER = price * _rates.sarSouth;
  else if (currency === 'USD') priceYER = price * _rates.usdSouth;
  
  // حساب العملات الأخرى
  var priceSAR = _rates.sarSouth > 0 ? Math.round(priceYER / _rates.sarSouth) : 0;
  var priceUSD = _rates.usdSouth > 0 ? Math.round(priceYER / _rates.usdSouth) : 0;
  
  if (yerEl) yerEl.textContent = Math.round(priceYER).toLocaleString();
  if (sarEl) sarEl.textContent = priceSAR.toLocaleString();
  if (usdEl) usdEl.textContent = priceUSD.toLocaleString();
}


