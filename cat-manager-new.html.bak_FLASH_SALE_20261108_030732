function calcProfit() {
  var price = parseFloat((document.getElementById('pf-price')||{}).value) || 0;
  var cost = parseFloat((document.getElementById('pf-cost')||{}).value) || 0;
  var el = document.getElementById('profit-display');
  if (!el) return;
  if (price <= 0 || cost <= 0) { el.textContent = '—'; el.style.color = '#6b7280'; return; }
  var profit = price - cost;
  var margin = ((profit / price) * 100).toFixed(1);
  if (profit > 0) {
    el.textContent = profit.toLocaleString() + ' (' + margin + '%)';
    el.style.color = margin > 30 ? '#10b981' : (margin > 15 ? '#f59e0b' : '#ef4444');
  } else {
    el.textContent = '⚠️ خسارة!';
    el.style.color = '#ef4444';
  }
}

